# Raw + processed corpus. 516MB download; `make data` rebuilds it from the
# HuggingFace mirror in a few minutes, so it does not belong in git.
data/raw/
data/processed/

# Secrets
.env

# Machine-local run state, not results
cache/ratelimit/
results/*.log

# The LLM response cache IS committed - it is what makes `make reproduce` work
# offline without API keys. Only the scratch temp files are excluded.
cache/llm/**/*.tmp

__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
