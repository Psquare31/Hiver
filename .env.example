# Free-tier API keys. Both are free and take ~2 minutes to obtain.
# Gemini : https://aistudio.google.com/apikey  (no card required)
# Groq   : https://console.groq.com/keys       (no card required)

GEMINI_API_KEY=
GROQ_API_KEY=

# Set to 1 to forbid network calls and serve only from the committed cache.
# This is what `make reproduce` uses so a reviewer without keys gets the
# published numbers exactly, or a loud error - never a silent partial run.
LLM_OFFLINE=0
